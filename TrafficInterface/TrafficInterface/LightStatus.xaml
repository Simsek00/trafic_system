<Page x:Class="TrafficInterface.LightStatus"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrafficInterface"
      mc:Ignorable="d"
      Title="LightStatus" Width="311" Height="454">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB8B5D9"/>
                <GradientStop Color="#FF38346C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border BorderBrush="Black" BorderThickness="1" Margin="10,65,213,191" Background="#FF2B2828">
            <StackPanel>
                <Rectangle x:Name="T_RedLight" Height="47" Stroke="Black" Width="50" Fill="Red" Margin="0,15,0,0"/>
                <Rectangle x:Name="T_YellowLight" Height="47" Stroke="Black" Width="50" Fill="#FF3F4200" Margin="0,15,0,0"/>
                <Rectangle x:Name="T_YellowLight_Kopyala" Height="47" Stroke="Black" Width="50" Fill="#FF074D01" Margin="0,15,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="LightName" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="LightName" VerticalAlignment="Top" FontSize="18" FontWeight="Bold"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="42,263,245,10" Background="#FF2B2828"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="71,288,199,86" Background="#FF2B2828">
            <StackPanel>
                <Border x:Name="P_RedLight" BorderBrush="Black" BorderThickness="1" Height="25" Width="25" Background="#FF4A0000" Margin="0,10,0,0"/>
                <Border x:Name="P_GreenLight" BorderBrush="Black" BorderThickness="1" Height="25" Width="25" Background="Lime" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="120,65,10,29">
            <StackPanel Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Profil:" FontSize="18" Width="88"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Text="YOĞUN" Width="94" Padding="15,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Mod:" FontSize="18" Width="88"/>
                <TextBlock TextWrapping="Wrap" FontSize="18" Text="GECE" Width="94" Padding="15,0,0,0"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="Araç Trafik Işığı" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0" FontSize="18" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="Kalan Süre:" FontSize="18"/>
                <TextBlock TextWrapping="Wrap" Text="15" FontSize="18" Width="94" Padding="15,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock TextWrapping="Wrap" Text="Geçen Araba Sayısı" FontSize="18" Height="77" Width="86"/>
                <TextBlock TextWrapping="Wrap" Text="5" FontSize="18" Width="94" Padding="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="Yaya Trafik Işığı" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock TextWrapping="Wrap" Text="Kalan Süre:" FontSize="18"/>
                <TextBlock TextWrapping="Wrap" Text="15" FontSize="18" Width="94" Padding="15,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="18" Text="Yaya Buton Sayısı:" Width="88"/>
                <TextBlock TextWrapping="Wrap" Text="15" FontSize="18" Width="94" Padding="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

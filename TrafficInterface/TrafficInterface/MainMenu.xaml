<Page x:Class="TrafficInterface.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrafficInterface"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMenu">
    <Page.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF070058" Offset=".6"/>
            <GradientStop Color="Black" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="225*"/>
            <RowDefinition Height="88*"/>
            <RowDefinition Height="137*"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Trafik Kontrol Sistemi" VerticalAlignment="Center" Margin="0,141,0,0" FontSize="36" Foreground="White" FontFamily="Global User Interface"/>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="0,222,0,0" HorizontalAlignment="Center" Height="60" Width="230" Grid.RowSpan="2">
            <Button x:Name="SistemDurumuButonu" Content="Sistem Durumu" Height="60.3" Width="60" Click="Button_Click"/>
            <Button x:Name="ProfillerButonu" Content="Profiller" Height="60.3" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0,0,0"/>
            <Button x:Name="KayıtlarButonu" Content="Kayıtlar" Height="60.3" Width="60" Margin="25,0,0,0"/>
        </StackPanel>
        <Frame x:Name="FrameMain" Content="Frame" Margin="2,0,2,0" Grid.RowSpan="3"/>

    </Grid>
</Page>

<Page x:Class="TrafficInterface.TrafficSystemDisplayer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrafficInterface"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TrafficSystemDisplayer">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF120097"/>
                <GradientStop Color="#FF050029" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel Margin="10,10,10,10" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Frame x:Name="Frame1" Content="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0,0,0"/>
            <Frame x:Name="Frame2" Content="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0,0,0"/>
            <Frame x:Name="Frame3" Content="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0,0,0"/>
            <Frame x:Name="Frame4" Content="Frame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0,0,0"/>
        </StackPanel>
        <Border BorderBrush="Black" BorderThickness="1" VerticalAlignment="Bottom" Background="Black" Height="46" Margin="0,404,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Profiller" Height="31" Width="72" Click="ProfileButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

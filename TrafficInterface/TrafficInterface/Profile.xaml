<Page x:Class="TrafficInterface.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrafficInterface"
      mc:Ignorable="d"
      Title="Profile" Width="376" Height="475.9">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFB7B7B7"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Text="Araç" HorizontalAlignment="Center" Margin="0,15,0,10" FontSize="20" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="52" TextWrapping="Wrap" Text="Kırmızı Süresi" Width="184" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBox x:Name="CarRLight" Height="52" TextWrapping="Wrap" Text="5" Width="190" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="52" TextWrapping="Wrap" Text="Sarı Süresi" Width="184" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBox x:Name="CarYLight" Height="52" TextWrapping="Wrap" Text="5" Width="190" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="52" TextWrapping="Wrap" Text="Yeşil Süresi" Width="184" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBox x:Name="CarGLight" Height="52" TextWrapping="Wrap" Text="5" Width="190" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="Yaya" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,10"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="52" TextWrapping="Wrap" Text="Kırmızı Süresi" Width="184" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBox Height="52" TextWrapping="Wrap" Text="5" Width="190" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Height="52" TextWrapping="Wrap" Text="Yeşil Süresi" Width="184" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBox Height="52" TextWrapping="Wrap" Text="5" Width="190" TextChanged="TextBox_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
